# Copy to .env.local. Set only the provider you use. Never commit real keys.
SAIL_API_KEY=

# OpenAI-compatible endpoint, for example scripts/modal_vllm.py. The base URL ends in /v1.
MODAL_BASE_URL=
MODAL_API_KEY=
# Only for endpoints behind Modal proxy auth.
MODAL_PROXY_KEY=
MODAL_PROXY_SECRET=

ANTHROPIC_API_KEY=
